<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <!-- Generated packages export their TS sources under the `bun` condition, which Bun applies
         by default, so `bun test` runs the transpiled code without a dist build. -->
    <MetanoSourceCondition>bun</MetanoSourceCondition>
  </PropertyGroup>
</Project>
